#!/bin/sh
# run Vampire on mathematical statements written in LaTeX and check that it
# behaves as expected: same spirit, same helpers and same rules as checks/sanity
# (minimal, no portfolio modes), kept apart so that checks/sanity stays what it was.
#
#     sh checks/latex-sanity build/vampire
#
# Who works on what. A statement of first-order logic over plain sets: Vampire
# searches, the mathematical engine judges the models it finds, and the
# independent checker follows Vampire's proofs inference by inference. A
# statement with sets of parts or of maps: the engine goes first, Vampire is
# asked for a proof when the engine has none. Mathematics proper: the engine;
# a statement with quantifiers over numbers that it cannot decide is given to
# Vampire's arithmetic theories. The independent checker judges every certificate.
#
# What is checked, for each document in checks/latex/:
#   - the result of every statement ("% Result N: Code (who decided)") and the summary;
#   - that no false statement is reported as a theorem and no invalid writing is read;
#   - that every certificate written is accepted by the checker as a program of
#     its own (certificate-checker), and that the same certificates, altered, are not.

# where is Vampire? passed by CI
vampire="`pwd`/$1 --traceback on"

scratch=`mktemp -d "${TMPDIR:-/tmp}/vampire-latex-sanity.XXXXXX"` || exit 1
trap 'rm -rf "$scratch"' EXIT
trap 'rm -rf "$scratch"; exit 130' INT
trap 'rm -rf "$scratch"; exit 143' TERM

# the exit code is not checked: with LaTeX input it says whether every
# statement was proved or solved, and the documents here have false ones
run_vampire() {
	echo $vampire $@
	(cd checks; $vampire $@ > "$scratch/vampire-stdout" 2> "$scratch/vampire-stderr")
	errors=`grep -E 'SIG|viola|error' "$scratch/vampire-stderr"`
	if test -n "$errors"
	then
		echo "run failed: contains errors"
		cat "$scratch/vampire-stderr"
		exit 1
	fi
}

# check the results of a document, statement by statement, against checks/latex/NAME.expected
check_results() {
	name=$1
	shift
	run_vampire --proof off -t 10 $@ latex/$name.tex
	grep '^% Result\|^% Summary' "$scratch/vampire-stdout" > "$scratch/results"
	diff=`diff checks/latex/$name.expected "$scratch/results"`
	if test -n "$diff"
	then
		echo "check against checks/latex/$name.expected failed: diff follows"
		echo "$diff"
		exit 1
	fi
}

# check that a key substring appears in the output
check_output_contains() {
	expected="$1"
	shift
	run_vampire $@
	found=`grep -F "$expected" "$scratch/vampire-stdout"`
	if test -z "$found"
	then
		echo "check failed: output should contain: $expected"
		cat "$scratch/vampire-stdout"
		exit 1
	fi
}

# check that a substring does NOT appear in the output
check_output_lacks() {
	unexpected="$1"
	shift
	run_vampire $@
	found=`grep -F "$unexpected" "$scratch/vampire-stdout"`
	if test -n "$found"
	then
		echo "check failed: output should not contain: $unexpected"
		cat "$scratch/vampire-stdout"
		exit 1
	fi
}

# the six documents, statement by statement
check_results logic
check_results mathematics
check_results false
check_results invalid
check_results parts
check_results numbers

# no false statement is a theorem, however it is decided, and no invalid writing is read.
# (Where Vampire's arithmetic refutes a statement by proving its negation, the status
# Vampire prints is of the problem named "the negation of ...", and is the only
# "Theorem" allowed here.)
check_output_lacks ": Theorem" --proof off -t 10 latex/false.tex
check_output_lacks "Theorem for false.tex" --proof off -t 10 latex/false.tex
check_output_contains "% SZS status Theorem for the negation of false.tex#9" --proof off -t 10 latex/false.tex
check_output_lacks "Theorem" --proof off -t 10 latex/invalid.tex
check_output_lacks "CounterSatisfiable" --proof off -t 10 latex/invalid.tex

# a statement of logic is Vampire's problem in every mode: here it is only printed, as TPTP
check_output_contains "tff(hypothesis_1,axiom" --mode output --input_syntax latex latex/logic.tex

# a theorem found by Vampire is certified when the checker has followed Vampire's
# own inferences one by one: Vampire refutes again the clauses the checker builds
# from the statement, and each inference becomes a step of the certificate.
# Statements 10 and 11 need Vampire's splitting, which the checker follows too
check_output_contains "% Result 1: TheoremCertified (vampire)" -t 10 latex/logic.tex
check_output_contains "% Result 10: TheoremCertified (vampire)" -t 10 latex/logic.tex
check_output_contains "% Result 11: TheoremCertified (vampire)" -t 10 latex/logic.tex
check_output_contains "% Vampire's inferences rechecked by the independent checker" -t 10 latex/logic.tex

# without that recheck the engine rebuilds the proof as a certificate of its own,
# and only then is the theorem certified: statement 10 is proved by Vampire and the
# engine cannot rebuild it, so it is "found but not independently verified"
check_output_contains "% Result 1: TheoremCertified (vampire)" -t 10 --math_recheck_time 0 latex/logic.tex
check_output_contains "% Result 10: TheoremUnverified (vampire)" -t 10 --math_recheck_time 0 latex/logic.tex
check_output_contains "proof found but not independently verified" -t 10 --math_recheck_time 0 latex/logic.tex
check_output_contains "prova trovata ma non verificata indipendentemente" -t 10 --math_recheck_time 0 --math_language it latex/logic.tex
check_output_lacks "inferences rechecked" -t 10 --math_recheck_time 0 latex/logic.tex

# Vampire's proof is told step by step, in both languages
check_output_contains "Superposition: an equation of one clause" -t 10 latex/logic.tex
check_output_contains "Superposizione: un'equazione di una clausola" -t 10 --math_language it latex/logic.tex

# with sets of parts the engine goes first; where it has no answer Vampire is asked.
# Statement 4 asks for an example that does not exist: Vampire refutes it from the
# engine's laws, and the checker follows the refutation. Without the recheck the
# refutation is reported as Vampire's own, unverified
check_output_contains "% Result 1: TheoremCertified (engine)" --proof off -t 10 latex/parts.tex
check_output_contains "% Result 4: RefutationCertified (vampire)" --proof off -t 10 latex/parts.tex
check_output_contains "% Result 4: CounterexampleUnverified (vampire)" --proof off -t 10 --math_recheck_time 0 latex/parts.tex

# a quantifier on the parts of a set has no first-order form of its own. Where the
# engine has no answer Vampire refutes the clauses of the checker, with the parts the
# engine proposes: statement 7 is induction (the part of the x with f(x) = x), and
# statement 8 asks for an example that the empty part rules out
check_output_contains "% Result 7: TheoremCertified (vampire)" --proof off -t 10 latex/parts.tex
check_output_contains "% Result 8: RefutationCertified (vampire)" --proof off -t 10 latex/parts.tex
check_output_contains "comprehend 0 (clause (eq (f 2 (v 0)) (v 0)))" --proof off -t 10 --math_certificates /dev/stdout latex/parts.tex

# two sets supposed equipotent: the engine goes first (statement 10). Where it has no
# answer (statement 9) Vampire proves the statement with the bijection given as two
# maps inverse to each other, and the checker follows its refutation of the clauses,
# among which an equipotence can be used and not proved. Without that recheck the
# proof is found, not verified, and the output says from what it was proved
check_output_contains "% Result 9: TheoremCertified (vampire)" --proof off -t 10 latex/parts.tex
check_output_contains "% Result 9: TheoremUnverified (vampire)" --proof off -t 10 --math_recheck_time 0 latex/parts.tex
check_output_contains "with each supposed bijection given as two maps inverse to each other" --proof off -t 10 --math_recheck_time 0 latex/parts.tex
check_output_contains "% Result 10: TheoremCertified (engine)" --proof off -t 10 latex/parts.tex
check_output_contains "psi1(phi1(X0)) = X0" --mode output --math_model_time 0 latex/parts.tex
check_output_contains "tff(law_1,axiom" --mode output --math_model_time 0 latex/parts.tex

# a statement on numbers that the engine cannot decide goes to Vampire's arithmetic
# theories, as it is and as its negation: what is proved there is found, not verified,
# and says which of the two was proved. Variables of two kinds are not handed over
check_output_contains "% Result 3: TheoremUnverified (vampire)" --proof off -t 10 latex/numbers.tex
check_output_contains "as a problem over \$int, and Vampire proved the statement" --proof off -t 10 latex/numbers.tex
check_output_contains "% Result 6: CounterexampleUnverified (vampire)" --proof off -t 10 latex/numbers.tex
check_output_contains "as a problem over \$int, and Vampire proved its negation" --proof off -t 10 latex/numbers.tex

# where numbers settle the statement Vampire is asked for them too, and the checker
# recomputes the statement on them: statement 5 is false with x = 101, y = 102 (and the
# two k of its hypotheses), a counterexample verified. Statement 6 is "for every m
# there is x": no numbers refute it, and it stays not verified
check_output_contains "% Result 5: CounterexampleVerified (vampire)" --proof off -t 10 latex/numbers.tex
check_output_contains "% SZS answers Tuple [[" --proof off -t 10 latex/numbers.tex
check_output_contains 'Counterexample (LaTeX): $x = ' --proof off -t 10 latex/numbers.tex
check_output_contains "The independent checker recomputed the statement on those numbers" --proof off -t 10 latex/numbers.tex
check_output_contains "% Result 7: Unsolved (engine)" --proof off -t 10 latex/numbers.tex
check_output_lacks "Certified" --proof off -t 10 latex/numbers.tex
check_output_contains "% Result 3: Unsolved (engine)" --proof off -t 10 --math_numbers_time 0 latex/numbers.tex
check_output_lacks "(vampire)" --proof off -t 10 --math_numbers_time 0 latex/numbers.tex

# a model found by Vampire is judged by the engine as its own, and the empty set is a set
check_output_contains '% Engine verdict: FALSO: controesempio $S = \{\}$; $f = \emptyset$; certificato verificato' --proof off -t 10 latex/logic.tex

# TPTP input is untouched by all this: no verification line, the usual status
check_output_lacks "Verification status" -t 10 Problems/PUZ/PUZ001+1.p
check_output_contains "% SZS status Theorem for PUZ001+1" -t 10 Problems/PUZ/PUZ001+1.p

# the certificates: accepted by the checker on its own, rejected once altered.
# The checker is the program built next to Vampire (target certificate-checker);
# if it is not there it is compiled here, from its one source file
checker="`dirname $1`/certificate-checker"
if test -x "$checker"
then
	cp "$checker" "$scratch/checker"
else
	cc -std=c11 -O2 -o "$scratch/checker" Math/quaerens/checker.c 2> "$scratch/checker-build"
fi
if test -x "$scratch/checker"
then
	for name in logic mathematics false parts numbers
	do
		run_vampire --proof off -t 10 --math_certificates "$scratch/$name.cert" latex/$name.tex
		written=`grep -c '^certificate' "$scratch/$name.cert"`
		accepted=`"$scratch/checker" "$scratch/$name.cert" | grep -c 'ACCETTATO'`
		if test "$written" -eq 0 || test "$written" -ne "$accepted"
		then
			echo "check failed: $written certificates written for $name.tex, $accepted accepted by the checker"
			exit 1
		fi

		# every certificate altered where it says what is claimed: the statement
		# denied, the truth of every row of a sign table swapped, a derivative
		# with 1 added. None may be accepted any more.
		# (one rule per kind of certificate in these documents: a new kind needs its own)
		sed -e 's/^statement \(.*\)$/statement (not \1)/' \
		    -e 's/^\(interval .*\) true$/\1 SWAPPED/' -e 's/^\(interval .*\) false$/\1 true/' -e 's/^\(interval .*\) SWAPPED$/\1 false/' \
		    -e 's/^\(point .*\) true$/\1 SWAPPED/' -e 's/^\(point .*\) false$/\1 true/' -e 's/^\(point .*\) SWAPPED$/\1 false/' \
		    -e 's/^derivative \(.*\)$/derivative (+ \1 1)/' \
		    "$scratch/$name.cert" > "$scratch/$name.altered"
		if cmp -s "$scratch/$name.cert" "$scratch/$name.altered"
		then
			echo "check failed: the certificates of $name.tex were not altered at all"
			exit 1
		fi
		accepted=`"$scratch/checker" "$scratch/$name.altered" | grep -c 'ACCETTATO'`
		if test "$accepted" -ne 0
		then
			echo "check failed: $accepted altered certificates of $name.tex accepted"
			exit 1
		fi
	done

	# a refutation without its last step does not reach the empty clause: every
	# certificate that follows Vampire's inferences must be rejected, the others
	# are untouched
	for name in logic parts
	do
		awk '{ if (held != "" && !($0 == "end" && held ~ /^step /)) print held; held = $0 } END { print held }' \
		    "$scratch/$name.cert" > "$scratch/$name.cut"
		saturations=`grep -c '^certificate saturation' "$scratch/$name.cert"`
		before=`"$scratch/checker" "$scratch/$name.cert" | grep -c 'ACCETTATO'`
		after=`"$scratch/checker" "$scratch/$name.cut" | grep -c 'ACCETTATO'`
		if test "$saturations" -eq 0 || test `expr "$before" - "$after"` -ne "$saturations"
		then
			echo "check failed: $saturations refutations of $name.tex lost their last step, $before certificates accepted before and $after after"
			exit 1
		fi
	done

	# a model with one value changed is another model: the checker must not accept it for the statement
	run_vampire --proof off -t 10 --math_certificates "$scratch/logic.cert" latex/logic.tex
	sed 's/^sort \([A-Za-z0-9]*\) 2$/sort \1 1/' "$scratch/logic.cert" > "$scratch/logic.resized"
	before=`"$scratch/checker" "$scratch/logic.cert" | grep -c 'ACCETTATO'`
	after=`"$scratch/checker" "$scratch/logic.resized" | grep -c 'ACCETTATO'`
	if test "$after" -ge "$before"
	then
		echo "check failed: a certificate with a set made smaller is still accepted ($before before, $after after)"
		exit 1
	fi
else
	echo "no certificate-checker next to Vampire and no C compiler: the certificates were not rechecked"
	cat "$scratch/checker-build"
	exit 1
fi
